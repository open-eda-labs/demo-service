<?xml version="1.0" encoding="UTF-8"?>
<!-- Sem lookups no pattern; %m{nolookups} reforça o log4j2.formatMsgNoLookups. -->
<Configuration status="WARN">
  <Appenders>
    <Console name="console" target="SYSTEM_OUT">
      <PatternLayout pattern="%d{ISO8601} %-5p %c{1} - %m{nolookups}%n"/>
    </Console>
  </Appenders>
  <Loggers>
    <Root level="info">
      <AppenderRef ref="console"/>
    </Root>
  </Loggers>
</Configuration>
